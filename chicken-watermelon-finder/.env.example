# Copy this file to `.env` and fill in your key, OR set the key directly
# in app.json under expo.extra.googlePlacesApiKey.
#
# Get a key from https://console.cloud.google.com/ with these APIs enabled:
#   - Places API
#   - Maps SDK for Android
#   - Maps SDK for iOS
GOOGLE_PLACES_API_KEY=your_key_here
